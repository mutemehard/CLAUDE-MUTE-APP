# MUTE App - Configuration des APIs
# Copiez ce fichier vers .env et remplissez vos cles API

# Ticketmaster Discovery API (recommande - meilleure couverture)
# Inscription gratuite: https://developer.ticketmaster.com/
# 5000 requetes/jour gratuites
TICKETMASTER_API_KEY=your_ticketmaster_api_key_here

# Songkick API (optionnel)
# Inscription: https://www.songkick.com/developer
SONGKICK_API_KEY=your_songkick_api_key_here

# OpenAgenda API (optionnel - evenements locaux)
# Inscription: https://openagenda.com/
OPENAGENDA_API_KEY=your_openagenda_api_key_here

# Note: Bandsintown ne necessite pas de cle API
# L'app utilise un app_id public pour acceder aux donnees
