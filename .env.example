# MUTE App - Configuration des APIs
# Copiez ce fichier vers .env et remplissez vos cles API

# ===========================================
# APIs DE CONCERTS (au moins une recommandee)
# ===========================================

# Ticketmaster Discovery API (recommande - meilleure couverture)
# Inscription gratuite: https://developer.ticketmaster.com/
# 5000 requetes/jour gratuites
TICKETMASTER_API_KEY=your_ticketmaster_api_key_here

# Songkick API (optionnel)
# Inscription: https://www.songkick.com/developer
SONGKICK_API_KEY=your_songkick_api_key_here

# OpenAgenda API (optionnel - evenements locaux)
# Inscription: https://openagenda.com/
OPENAGENDA_API_KEY=your_openagenda_api_key_here

# ===========================================
# APIs GRATUITES (pas de cle requise)
# ===========================================

# Les sources suivantes fonctionnent sans cle API:
# - Bandsintown (app_id: mute_concert_app)
# - Resident Advisor (scraping GraphQL)
# - Shotgun (scraping API interne)
# - Dice (scraping GraphQL + web)
# - Paris Venues (scraping direct des salles)

# ===========================================
# GOOGLE MAPS (optionnel - pour Android)
# ===========================================

# Google Maps API Key (necessaire uniquement pour Android)
# iOS utilise Apple Maps par defaut
# Inscription: https://console.cloud.google.com/
# Activer: Maps SDK for Android
# GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
# Note: Mettre a jour app.json avec la cle
